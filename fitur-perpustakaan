// ======================= PENGELOLA DATA (COLLECTION) =======================
class Perpustakaan {
    // HashMap untuk data login, ArrayList untuk buku & transaksi
    private final Map<String, Pengguna> akun = new HashMap<>();
    private final ArrayList<Buku> daftarBuku = new ArrayList<>();
    private final ArrayList<Transaksi> daftarTransaksi = new ArrayList<>();

    public Perpustakaan() {
        akun.put("admin", new Admin("admin", "admin123", "Administrator"));
        akun.put("budi", new Anggota("budi", "123", "Budi Santoso"));

        daftarBuku.add(new Buku("Pemrograman Java Dasar", "Rudi Hartono", 2020, 5));
        daftarBuku.add(new Buku("Struktur Data dan Algoritma", "Dewi Lestari", 2019, 3));
        daftarBuku.add(new Buku("Basis Data Lanjut", "Ahmad Fauzi", 2021, 4));
        daftarBuku.add(new Buku("Laskar Pelangi", "Andrea Hirata", 2005, 2));
        daftarBuku.add(new Buku("Bumi Manusia", "Pramoedya Ananta Toer", 1980, 2));
    }

    // ---------- Autentikasi ----------
    public Pengguna login(String username, String password) throws PerpustakaanException {
        Pengguna p = akun.get(username);
        if (p == null || !p.cekPassword(password)) {
            throw new PerpustakaanException("Username atau password salah.");
        }
        return p;
    }

    public void daftarAnggota(String username, String password, String nama) throws PerpustakaanException {
        if (akun.containsKey(username)) {
            throw new PerpustakaanException("Username \"" + username + "\" sudah digunakan.");
        }
        akun.put(username, new Anggota(username, password, nama));
    }

  
